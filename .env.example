# Copy this file to `.env` and populate with real secrets.
# Never commit `.env`.

# =========================================
# OKX (primary exchange)
# =========================================
OKX_API_KEY=your_okx_live_api_key_here
OKX_SECRET_KEY=your_okx_live_secret_key_here
OKX_PASSPHRASE=your_okx_live_passphrase_here

# OKX testnet/sandbox
OKX_TESTNET_API_KEY=your_okx_testnet_api_key_here
OKX_TESTNET_SECRET_KEY=your_okx_testnet_secret_key_here
OKX_TESTNET_PASSPHRASE=your_okx_testnet_passphrase_here

# =========================================
# Optional Binance keys (legacy/reference)
# =========================================
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# =========================================
# Trading mode
# =========================================
TRADING_MODE=testnet
OKX_API_BASE_URL=https://openapi.okx.com
# The Discord confirmation flow is demo-only and refuses live-mode submission.
OKX_EXECUTION_ENABLED=true
OKX_MAX_SLIPPAGE_PCT=0.005
OKX_MAX_ORDER_NOTIONAL_USDT=100
ORDER_SUGGESTION_TTL_SECS=900
LIVE_BASELINE_MODEL_DIR=models/live_baseline
LIVE_SESSION_TIMEZONE=Asia/Bangkok
UI_USERNAME=
UI_PASSWORD=
UI_SESSION_SECRET=change-me-before-deploy
UI_BIND_HOST=127.0.0.1
UI_PORT=8080
UI_TAIL_LINES_DEFAULT=200
UI_LOGIN_RATE_LIMIT=5
UI_ENABLE_CONTROLS=false
UI_CONTROL_USE_SUDO=false
UI_TRUST_TAILSCALE_HEADERS=false
UI_ALLOWED_TAILSCALE_USERS=
UI_ADMIN_TAILSCALE_USERS=
UI_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# TradingView-style analyst web frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8080/ws/analyst
NEXT_PUBLIC_CANDLE_REFRESH_MS=5000

# =========================================
# Analyst-only LLM + Discord interface
# No fallback decisions: provider errors are recorded as errors.
# =========================================
ANALYST_ENABLED=false
ANALYST_TIMEFRAME_POLL_SECS=5
ANALYST_TIMEFRAME_CONTEXT_TTL_SECS=14400
MANUAL_ANALYSIS_CACHE_SECS=300
ANALYST_SYMBOLS=BTCUSDT
ANALYST_SIGNIFICANT_CONFIDENCE=0.65
ANALYST_RL_CADENCE=1h
ANALYST_INTRADAY_RISK_TIMEFRAME=15m
ANALYST_EVENT_LIMIT=200
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Candle-bound model lanes. 1m, 15m and 1h use the lower provider; 4h and
# MANUAL_MODEL use LLM_BASE_URL/LLM_API_KEY (for example, ShopAIKey).
LLM_1_MIN_MODEL=
LLM_15_MIN_MODEL=
LLM_1_HOUR_MODEL=
LLM_4_HOUR_MODEL=
MANUAL_MODEL=
LLM_LOWER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_LOWER_API_KEY=
LLM_LOWER_FALLBACK_API_KEY=
# Legacy routing aliases remain supported, but are not used by new installs.
LLM_WEAK_MODEL=
LLM_STRONG_MODEL=
LLM_BACKGROUND_MODEL=
LLM_INTERACTIVE_MODEL=
LLM_TIMEOUT_SECS=20
LLM_WEAK_TIMEOUT_SECS=20
LLM_STRONG_TIMEOUT_SECS=60
LLM_USE_RESPONSE_FORMAT=false
# Pause each failing model lane after three consecutive failures. A successful
# half-open retry resets the lane; screening, scheduled, and manual are isolated.
LLM_FAILURE_THRESHOLD=3
LLM_FAILURE_COOLDOWN_SECS=300
# Weak screening and scheduled strong analysis use separate allowances so
# neither can consume the manual strong-model budget.
LLM_DAILY_CALL_BUDGET=8
LLM_SCREENING_CALL_BUDGET=12000
LLM_SCHEDULED_CALL_BUDGET=200
LLM_INTERACTIVE_CALL_BUDGET=12
LLM_1_MIN_CALL_BUDGET=2880
LLM_15_MIN_CALL_BUDGET=192
LLM_1_HOUR_CALL_BUDGET=48
LLM_4_HOUR_CALL_BUDGET=12
LLM_MANUAL_CALL_BUDGET=12
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_ANALYST_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=

# =========================================
# Optional official-X economic-alert layer
# Use an X developer App's app-only bearer token. Posts are alerts only; verify
# all economic releases and revisions on the issuer's primary website.
# =========================================
X_NEWS_BEARER_TOKEN=
X_NEWS_ACCOUNTS=BLS_gov,BEA_News,FederalReserve,uscensusbureau,EIAgov,USTreasury,ECB,bankofengland,statcan_eng,absstats
X_NEWS_POSTS_PER_ACCOUNT=2

# =========================================
# Optional LLM provider keys for integrations
# Research default is local Ollama only; no hosted LLM key is required.
# =========================================
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b-gpu8k
OLLAMA_VULKAN=1
XAI_API_KEY=

# =========================================
# Optional LLM risk-gate tuning (local Ollama)
# =========================================
LLM_RISK_GATE_MODEL=qwen3.5:4b-gpu8k
LLM_RISK_GATE_CADENCE=weekly
LLM_RISK_GATE_CACHE_TTL=604800
LLM_RISK_GATE_MAX_CALLS_PER_DAY=8
LLM_RISK_GATE_MODE=de_risk
LLM_RISK_GATE_TIMEOUT_SECS=5

# =========================================
# Backtest/training realism controls
# Defaults preserve the current research baseline.
# =========================================
SLIPPAGE_MODEL=flat
SLIPPAGE_VOL_WINDOW=24
SLIPPAGE_VOL_SCALAR=10
SLIPPAGE_VOL_CAP_MULT=3

KILL_SWITCH_ENABLED_EVAL=false
KILL_SWITCH_DRAWDOWN_THRESHOLD=-0.15

STEP_TURNOVER_CAP_ENABLED=false
STEP_TURNOVER_CAP_NORMAL=0.20
STEP_TURNOVER_CAP_STRESS=0.12
STEP_TURNOVER_CAP_CRISIS=0.08

# Promoted execution-control baseline from the live-ready champion.
REBALANCE_THRESHOLD_NORMAL=0.03
REBALANCE_THRESHOLD_STRESS=0.05
REBALANCE_THRESHOLD_CRISIS=0.08
MIN_HOLD_BARS=4
MATERIAL_TRADE_THRESHOLD=0.05
REVERSAL_HYSTERESIS_MULT=1.5
POSITION_RESET_WEIGHT_THRESHOLD=0.05
POSITION_RESET_PERSIST_BARS=2

# Optional reward/governor variant controls for controlled experiments.
REWARD_PROFIT_WEIGHT=1.0
REWARD_SHARPE_WEIGHT=0.0
REWARD_DRAWDOWN_WEIGHT=10.0
REWARD_TURNOVER_WEIGHT=1.0
REWARD_MISSED_OPPORTUNITY_WEIGHT=0.5
REWARD_TAIL_LOSS_WEIGHT=2.0
RISK_GOVERNOR_ENABLED=true
RISK_GOVERNOR_STRESS_MAX_RISK_ON=0.75
RISK_GOVERNOR_CRISIS_MAX_RISK_ON=0.55
# Mutable application state. Research CSV/parquet/report artifacts remain under results/ and report/.
OPERATIONAL_DATABASE_PATH=results/runtime/tradingbot.sqlite3
